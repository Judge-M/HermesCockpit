# Browser-facing port for the bundled nginx container.
COCKPIT_PORT=8088

# Hermes dashboard origin as seen from the nginx container. Do not add a
# trailing slash. On Linux, host.docker.internal is mapped to the Docker host.
HERMES_UPSTREAM=http://host.docker.internal:9119

# The values below belong in the Hermes service environment when the optional
# operations-portal integration is used. Leave them unset for a standalone
# Hermes Cockpit installation.
# HERMES_COCKPIT_PORTAL_URL=https://portal.example.net
# HERMES_COCKPIT_LINKS_JSON=[{"id":"grafana","name":"Grafana","kind":"Dashboards","url":"https://grafana.example.net"}]
