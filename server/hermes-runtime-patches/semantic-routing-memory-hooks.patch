+def apply_memory_route_middleware(sources: list[str], **context: Any) -> RequestMiddlewareResult:
+    """Allow plugins to narrow the memory providers already authorized by Hermes."""
+    from hermes_cli.plugins import has_middleware, invoke_middleware
+
+    original = list(sources)
+    if not has_middleware(MEMORY_ROUTE_MIDDLEWARE):
+        return RequestMiddlewareResult(payload=original, original_payload=original)
+    current = list(original)
+    trace: list[dict[str, Any]] = []
+    for result in invoke_middleware(
+        MEMORY_ROUTE_MIDDLEWARE, _payload_key="sources",
+        **middleware_payload(sources=list(current), original_sources=list(original), **context),
+    ):
+        if not isinstance(result, dict) or not isinstance(result.get("sources"), list):
+            continue
+        requested = [str(value) for value in result["sources"]]
+        # A plugin may only narrow the original authorized set, never add a provider.
+        current = [source for source in original if source in requested]
+        trace.append({
+            key: result[key] for key in ("source", "reason", "name")
+            if isinstance(result.get(key), str)
+        })
+    return RequestMiddlewareResult(
+        payload=current, original_payload=original, changed=bool(trace), trace=trace,
+    )
+
+
 def run_llm_execution_middleware(
     request: dict[str, Any], next_call: Callable[[dict[str, Any]], Any], **context: Any) -> Any:
     """Run provider execution through registered LLM execution middleware."""
