diff --git a/hermes_cli/plugin_runtime_context.py b/hermes_cli/plugin_runtime_context.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/plugin_runtime_context.py
@@ -0,0 +1,54 @@
+"""Trusted routing identity exported to isolated plugin middleware.
+
+No RPC params or browser-supplied owner IDs are identity authorities.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+
+
+def _scope(issuer: str, subject: str) -> str:
+    source = json.dumps({"issuer": issuer, "subject": subject}, sort_keys=True)
+    return hashlib.sha256(source.encode("utf-8")).hexdigest()
+
+
+def routing_context(context: dict) -> dict:
+    sid = str(context.get("session_id") or "")
+    if not sid:
+        try:
+            from agent.auxiliary_hooks import _parent_turn_identity
+            sid = str(_parent_turn_identity().get("session_id") or "")
+        except ImportError:
+            pass
+    server = sys.modules.get("tui_gateway.server")
+    result = {"_owner_context_verified": True, "owner_scope": "__unresolved__"}
+    if server is None:
+        result["owner_scope"] = "__single_user__"
+        return result
+    with server._sessions_lock:
+        matches = [
+            (runtime_id, record) for runtime_id, record in server._sessions.items()
+            if sid and sid in {
+                str(runtime_id), str(record.get("session_key") or ""),
+                str(getattr(record.get("agent"), "session_id", "") or ""),
+            }
+        ]
+        if len(matches) == 1:
+            runtime_id, record = matches[0]
+            owner = server._session_auth_user_id(record)
+            if owner is None:
+                result["owner_scope"] = "__single_user__"
+            elif isinstance(owner, str) and ":" in owner:
+                issuer, subject = owner.split(":", 1)
+                if issuer and subject:
+                    result["owner_scope"] = _scope(issuer, subject)
+            result["session_id"] = str(runtime_id)
+            return result
+    # A turn-less auxiliary call may still have an authenticated transport.
+    from tui_gateway.transport import current_transport
+    identity = getattr(current_transport(), "auth_identity", None)
+    if isinstance(identity, dict) and identity.get("provider") and identity.get("user_id"):
+        result["owner_scope"] = _scope(str(identity["provider"]), str(identity["user_id"]))
+    return result
