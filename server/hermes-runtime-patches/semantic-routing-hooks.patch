     )
 
 
+def apply_model_route_middleware(
+    slot: str, route: dict[str, Any], **context: Any,
+) -> RequestMiddlewareResult:
+    """Allow plugins to replace a resolved route with another concrete provider/model.
+
+    Callers remain responsible for validating and resolving credentials for the
+    returned route.  This middleware cannot execute a model or bypass provider
+    authentication; failures retain the route Hermes already resolved.
+    """
+    from hermes_cli.plugins import has_middleware
+
+    if not has_middleware(MODEL_ROUTE_MIDDLEWARE):
+        return RequestMiddlewareResult(payload=route, original_payload=route)
+    original_route = _safe_copy(route)
+    return _apply_request_chain(
+        MODEL_ROUTE_MIDDLEWARE, "route", [], original_route,
+        slot=slot, route=_safe_copy(original_route), original_route=original_route, **context,
+    )
+
+
 def run_llm_execution_middleware(
     request: dict[str, Any], next_call: Callable[[dict[str, Any]], Any], **context: Any) -> Any:
     """Run provider execution through registered LLM execution middleware."""
